{
  "name": "kriptop-hr-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.mjs",
    "test:mysql": "node --env-file-if-exists=.env --test integration/mysql.integration.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.24.6"
  }
}
